sequenceDiagram
    actor User
    participant FastAPI as FastAPI<br/>/chat Endpoint
    participant Session as ConversationalSession
    participant Redis as Redis Store
    participant Crew as Conversation Crew
    participant Agent as Conversational<br/>Agent
    participant ResearchCrew as Research Crew
    participant AnalysisCrew as Analysis Crew

    User->>FastAPI: POST /chat<br/>(session_id, message)
    activate FastAPI
    
    FastAPI->>Session: new ConversationalSession<br/>(session_id)
    activate Session
    
    Session->>Redis: get_history(session_id)
    activate Redis
    Redis-->>Session: conversation history
    deactivate Redis
    
    Session->>Session: append user message<br/>to history
    
    Session->>Session: summarize if needed<br/>(turns > 20)
    
    Session->>Crew: create_conversation_crew()
    activate Crew
    
    Crew->>Agent: kickoff_async(inputs)
    activate Agent
    
    alt User asks for research
        Agent->>ResearchCrew: research_workflow<br/>(query, context)
        activate ResearchCrew
        ResearchCrew-->>Agent: research result
        deactivate ResearchCrew
    else User provides data/numbers
        Agent->>AnalysisCrew: data_analysis_workflow<br/>(dataset, question, context)
        activate AnalysisCrew
        AnalysisCrew-->>Agent: analysis result
        deactivate AnalysisCrew
    else Normal conversation
        Agent->>Agent: generate response
    end
    
    Agent-->>Crew: reply
    deactivate Agent
    
    Crew-->>Session: crew result
    deactivate Crew
    
    Session->>Session: append assistant reply<br/>to history
    
    Session->>Redis: save_history(session_id, history)<br/>TTL: 3600s
    activate Redis
    Redis-->>Session: saved
    deactivate Redis
    
    Session-->>FastAPI: reply
    deactivate Session
    
    FastAPI-->>User: ChatResponse<br/>(session_id, reply, status)
    deactivate FastAPI